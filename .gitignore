# --- Dependencies (local npm install; not copied from Docker build) ---
node_modules/
**/node_modules/

# --- Build outputs (vite / tsc: local or CI; Docker image embeds its own build) ---
dist/
**/dist/
build/
**/build/

# --- SQLite & runtime data (docker compose: ./data:/data) ---
data/
*.db
*.db-wal
*.db-shm

# --- Environment (compose / secrets; keep .env.example in repo if you add one) ---
.env
.env.local
.env.*.local

# --- Logs & debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Tooling caches ---
*.tsbuildinfo
.eslintcache
coverage/

# --- OS & editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
